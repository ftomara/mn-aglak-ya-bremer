    {
      "id": "OWkXna2eq8D03Mbcopybo",
      "type": "text",
      "x": 24190.782531571193,
      "y": 7085.509932703558,
      "width": 2909.334106339068,
      "height": 1285.8071235183115,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "_hs9HLQGylh1s0cuytuxN"
      ],
      "frameId": null,
      "index": "b0k",
      "roundness": null,
      "seed": 850870815,
      "version": 1517,
      "versionNonce": 797504127,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790083602459,
      "created": 1790082447176,
      "link": null,
      "locked": false,
      "text": "customer places order through the order service which will make a request\nto item services to check the items availability by querying the items db\nand respond to order service, if items are available it should reserve them\nand decrease their quantity  in the stock (if not all items available it\nshould either cancel order or notify customer of the only available items\nand if confirmed it will continue prosessing), order service will make request\nto robot service to get available nearest robot fleet , if not enough\navailable the order will be delayed and the customer / operator will be\nnotified otherwise robots should be assigned to items and go execute the\ntask , to prevent duplicate submissions by cache and the timestamp the\ncache will have the last order have been done by the customer and will be\nmarked with the customer & order ids . so if it is the same order from the\nsame customer in time <300ms. then it shall be ordered once",
      "fontSize": 79.12659221651148,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "customer places order through the order service which will make a request to item services to check the items availability by querying the items db and respond to order service, if items are available it should reserve them and decrease their quantity  in the stock (if not all items available it should either cancel order or notify customer of the only available items and if confirmed it will continue prosessing), order service will make request to robot service to get available nearest robot fleet , if not enough available the order will be delayed and the customer / operator will be notified otherwise robots should be assigned to items and go execute the task , to prevent duplicate submissions by cache and the timestamp the cache will have the last order have been done by the customer and will be marked with the customer & order ids . so if it is the same order from the same customer in time <300ms. then it shall be ordered once",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "02Jfwcs6mz8xMzoJBzZyS",
      "type": "text",
      "x": 24228.676287957904,
      "y": 6878.767435092939,
      "width": 646.9679695103981,
      "height": 152.24207832708248,
      "angle": 0,
