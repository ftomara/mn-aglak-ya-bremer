    {
      "id": "50qJ2oqHVvxNuO2lZXJch",
      "type": "text",
      "x": -1439.7280482445487,
      "y": 1180.662310544505,
      "width": 1674.86376953125,
      "height": 810,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
